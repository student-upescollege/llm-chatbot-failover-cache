# ==========================================
# Backend Configuration
# ==========================================

# Comma-separated API keys pool (at least 2 keys required)
# Key ids are assigned in order: key_1, key_2, ...
LLM_API_KEYS=your_primary_api_key_here,your_secondary_fallback_key_here

# LLM Model identifier (LiteLLM format)
# Examples: gemini/gemini-2.0-flash, groq/llama-3.1-8b-instant, gpt-4o-mini
LLM_MODEL=gemini/gemini-2.0-flash

# SQLite Database Location
# In Docker, mounted to named volume at /data
DATABASE_URL=sqlite:////data/app.db

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Enable failover test hook (X-Simulate-Failure header support)
# Must be true on deployed backend
ENABLE_FAILURE_SIMULATION=true

# Default System Prompt
DEFAULT_SYSTEM_PROMPT=You are a helpful and concise AI assistant.

# ==========================================
# Frontend Configuration
# ==========================================
VITE_BACKEND_URL=http://localhost:8000
